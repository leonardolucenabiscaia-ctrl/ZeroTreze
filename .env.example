# Copie este arquivo para .env.local e preencha com as credenciais reais do projeto Supabase
# (Project Settings → API, no painel do Supabase). Nunca commitar o .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# WhatsApp (Meta Cloud API) — usado tanto pro webhook quanto pro envio de mensagens (código de
# acesso do primeiro login, substituindo o e-mail).
# WHATSAPP_VERIFY_TOKEN é inventado por nós (handshake do webhook, painel da Meta).
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN: token permanente gerado via Usuário do Sistema, no Business Settings da
# Meta (o token temporário da tela "Configuração da API" expira em 24h).
WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID: ID do número (não o número em si) — aparece no painel do WhatsApp
# Manager, na tela do número cadastrado.
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_*: nome de cada template de mensagem aprovado pela Meta (mensagens iniciadas
# pela empresa exigem template — não dá pra mandar texto livre). Um por tipo de notificação.
WHATSAPP_TEMPLATE_CODIGO_ACESSO=
WHATSAPP_TEMPLATE_PARCELA_2DIAS=
WHATSAPP_TEMPLATE_PARCELA_HOJE=
WHATSAPP_TEMPLATE_PARCELA_ONTEM=
WHATSAPP_TEMPLATE_NOVA_MULTA=
WHATSAPP_TEMPLATE_ACORDO_CRIADO=
WHATSAPP_TEMPLATE_CHAT_RESPONDIDO=
# Opcional — defina como "true" pra pausar só as notificações por WhatsApp (parcela, multa,
# acordo, chat); o código de primeiro acesso continua funcionando. Remova pra reativar.
WHATSAPP_NOTIFICACOES_PAUSADAS=

# CRON_SECRET: segredo gerado por nós — confirma que a chamada da tarefa agendada (cron, ver
# vercel.json) é legítima. A Vercel manda automaticamente como header quando esse env var existe.
CRON_SECRET=

# ClickSign — assinatura eletrônica (sandbox.clicksign.com → Configurações → API)
CLICKSIGN_ACCESS_TOKEN=
CLICKSIGN_BASE_URL=
CLICKSIGN_WEBHOOK_SECRET=
