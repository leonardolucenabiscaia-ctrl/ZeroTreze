# Copie este arquivo para .env.local e preencha com as credenciais reais do projeto Supabase
# (Project Settings → API, no painel do Supabase). Nunca commitar o .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# DocuSign — fluxo JWT Grant (admin.docusign.com → Apps and Keys)
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_URI=
DOCUSIGN_AUTH_SERVER=
# Chave privada RSA com quebras de linha reais substituídas por \n literal, entre aspas duplas.
DOCUSIGN_PRIVATE_KEY=

# WhatsApp (Meta Cloud API) — segredo inventado por nós para o handshake do webhook.
WHATSAPP_VERIFY_TOKEN=

# ClickSign — assinatura eletrônica (sandbox.clicksign.com → Configurações → API)
CLICKSIGN_ACCESS_TOKEN=
CLICKSIGN_BASE_URL=
CLICKSIGN_WEBHOOK_SECRET=
